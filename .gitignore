dist/

# The signed APK IS a deliverable here (repo is the distribution point), so
# release/ is deliberately NOT ignored.

# Signing secrets — NEVER commit. Losing these means you cannot ship an update
# to app id com.dux.pipelaying; users would have to uninstall and reinstall.
*.keystore
*.jks
android-shell/android/keystore.properties
android-shell/android/local.properties

